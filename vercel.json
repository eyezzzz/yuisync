{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)docs/**' ':(exclude)test/**' ':(exclude)tests/**' ':(exclude).github/**' ':(exclude)scripts/**' ':(exclude)supabase/**' ':(exclude)database/**' ':(exclude)**/*.md'",
  "functions": {
    "api/webhook.ts": {
      "maxDuration": 30
    },
    "api/meta/whatsapp.ts": {
      "maxDuration": 30
    },
    "api/admin/users.ts": {
      "maxDuration": 30
    },
    "api/admin/users/[userId].ts": {
      "maxDuration": 30
    },
    "api/admin/users/[userId]/status.ts": {
      "maxDuration": 30
    },
    "api/admin/maintenance/[action].ts": {
      "maxDuration": 30
    },
    "api/chat/respond.ts": {
      "maxDuration": 120
    },
    "api/chat/human-message.ts": {
      "maxDuration": 30
    },
    "api/fiscal/sales/[saleId]/issue.ts": {
      "maxDuration": 30
    },
    "api/fiscal/webhooks/focus.ts": {
      "maxDuration": 30
    },
    "api/products/image-suggestions.ts": {
      "maxDuration": 20
    },
    "api/petshop/checkout.ts": {
      "maxDuration": 30
    },
    "api/admin/petbot-e2e.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/whatsapp/webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}